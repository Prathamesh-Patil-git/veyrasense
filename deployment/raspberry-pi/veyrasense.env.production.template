# ==============================================================================
# VeyraSense Edge Gateway — Production Environment Configuration
# Target: Raspberry Pi 5 (Debian 13 Trixie, 64-bit ARM64)
# Deploy Location: /etc/veyrasense/veyrasense.env
# Permissions: chmod 0600 /etc/veyrasense/veyrasense.env
# Owner: chown veyrasense:veyrasense /etc/veyrasense/veyrasense.env
# ==============================================================================

# Execution Environment
ENVIRONMENT=production
PROJECT_NAME="VeyraSense Industrial Edge Gateway"
VERSION="0.3.0"
API_V1_PREFIX="/api/v1"

# Production Process Binding (Internal Loopback behind Nginx)
HOST="127.0.0.1"
PORT=8000
WORKERS=2

# Persistent State Directories (Outside replaceable release directories)
DATA_DIR="/var/lib/veyrasense/data"
DATABASE_URL="sqlite:////var/lib/veyrasense/data/veyrasense.db"
MOSQUITTO_CONFIG_DIR="/var/lib/veyrasense/mosquitto"
LOG_DIR="/var/log/veyrasense"
MODELS_DIR="/var/lib/veyrasense/models"
BACKUPS_DIR="/var/lib/veyrasense/backups"

# SQLite Reliability Tuning
SQLITE_BUSY_TIMEOUT_MS=5000

# Cryptographic Token Security
# IMPORTANT: Generate a secure 64-character hex secret before deployment:
# Command: openssl rand -hex 32
SECRET_KEY="REPLACE_WITH_GENERATED_PRODUCTION_SECRET_KEY_64_HEX"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Mosquitto MQTT Broker Integration (Isolated Listener Port 1884)
MQTT_BROKER_HOST="127.0.0.1"
MQTT_BROKER_PORT=1884
MQTT_BACKEND_USERNAME="veyrasense_backend"
# IMPORTANT: Generate a secure backend service password:
# Command: openssl rand -hex 24
MQTT_BACKEND_PASSWORD="REPLACE_WITH_GENERATED_BACKEND_MQTT_PASSWORD"

# Permitted CORS Origins (Local Network Gateway Hostnames and IPs)
CORS_ORIGINS=["http://localhost", "http://127.0.0.1", "http://veyrasense.local"]

# Initial Administrator Credentials (Bootstrap only; change password on first login)
DEV_ADMIN_EMAIL="admin@veyrasense.local"
DEV_ADMIN_PASSWORD="REPLACE_WITH_INITIAL_STRONG_ADMIN_PASSWORD"
DEV_ADMIN_NAME="VeyraSense Operations Lead"
