
[Unit]
Description=Daily VeyraSense Release Check and Deployment

[Timer]
# Run daily at 03:00 according to the Raspberry Pi's local timezone.
OnCalendar=*-*-* 03:00:00

# Randomize execution by up to 30 minutes.
RandomizedDelaySec=1800

# Run a missed deployment after the Pi starts again.
Persistent=true

# Do not run another deployment while the previous one is active.
Unit=veyrasense-update.service

[Install]
WantedBy=timers.target
