[Unit]
Description=VeyraSense Industrial Edge Gateway API (FastAPI)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=veyrasense
Group=veyrasense
WorkingDirectory=/opt/veyrasense/current/backend
EnvironmentFile=/etc/veyrasense/veyrasense.env

# Execution command using release virtualenv
ExecStart=/opt/veyrasense/current/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2

# Process Reliability & Sandboxing
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15s

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/veyrasense /var/log/veyrasense /run
PrivateTmp=true

# Standard Output & Logging
StandardOutput=append:/var/log/veyrasense/backend.log
StandardError=append:/var/log/veyrasense/backend.error.log

[Install]
WantedBy=multi-user.target
