
[Unit]
Description=VeyraSense Industrial Edge Gateway API (FastAPI)

# Start networking and Mosquitto before the backend.
Wants=network-online.target
After=network-online.target mosquitto.service

# Restart limits.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

User=veyrasense
Group=veyrasense

# Active release paths.
WorkingDirectory=/opt/veyrasense/current/backend

# Persistent production configuration.
EnvironmentFile=/etc/veyrasense/veyrasense.env

# Production Python settings.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Verify that the deployed Python environment exists.
ExecStartPre=/usr/bin/test -x /opt/veyrasense/current/backend/.venv/bin/python

# Run FastAPI using the active release virtual environment.
# Keep one worker on Raspberry Pi 5.
ExecStart=/opt/veyrasense/current/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1

# Process reliability.
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillMode=mixed

# Filesystem permissions and sandboxing.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0027

# Application write access.
ReadWritePaths=/var/lib/veyrasense
ReadWritePaths=/var/log/veyrasense

# Logging.
StandardOutput=append:/var/log/veyrasense/backend.log
StandardError=append:/var/log/veyrasense/backend.error.log

[Install]
WantedBy=multi-user.target
