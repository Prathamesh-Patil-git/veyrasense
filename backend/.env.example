# VeyraSense Edge Gateway Environment Configuration Template
# Copy to .env for local development

# Environment: "development" or "production"
ENVIRONMENT=development
PROJECT_NAME="VeyraSense API"
VERSION="0.3.0"
API_V1_PREFIX="/api/v1"

# Directory for SQLite database and local persistent state
DATA_DIR="data"

# SQLite Database URL (defaults to sqlite:///{DATA_DIR}/veyrasense.db if empty)
DATABASE_URL=""

# SQLite Connection Settings
SQLITE_BUSY_TIMEOUT_MS=5000

# Security - In production, generate a secure 32+ byte key with: openssl rand -hex 32
SECRET_KEY="veyrasense-dev-secret-change-in-production-only-32bytesmin"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173"]

# MQTT connection used by the gateway backend
MQTT_BROKER_HOST="127.0.0.1"
MQTT_BROKER_PORT=1883

# Address placed in ESP32 connection settings; use the Raspberry Pi LAN IP/hostname.
# Example only: change this to the gateway address reachable from your Wi-Fi network.
MQTT_DEVICE_BROKER_HOST="192.168.1.14"

# Seed Configuration (For development seeding only)
DEV_ADMIN_EMAIL="admin@veyrasense.local"
DEV_ADMIN_PASSWORD="VeyraSense2026!"
DEV_ADMIN_NAME="VeyraSense Operations Lead"
